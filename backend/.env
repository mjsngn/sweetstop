# Copy this file to a new file named ".env" (same folder) and edit the values.
# If you run MongoDB on your own computer you can skip .env completely —
# the defaults below are used automatically.

# Where your MongoDB database lives.
# Local MongoDB:   mongodb://127.0.0.1:27017/sweetstop
# MongoDB Atlas:   paste the connection string Atlas gives you, and add /sweetstop before the "?"
MONGODB_URI=mongodb+srv://mjsngn_db_user:mjsngn24@cluster0.blojjaj.mongodb.net/sweetstop

# A long random string used to sign login tokens. Change it before putting the site online.
JWT_SECRET=change-me-to-a-long-random-string

# The admin account that is created the FIRST time the server starts.
ADMIN_EMAIL=admin@sweetstop.local
ADMIN_PASSWORD=ChangeMe123!

PORT=3000
